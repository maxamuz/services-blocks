{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "services-blocks/trust-block",
	"version": "0.1.0",
	"title": "Trust Block",
	"category": "services",
	"icon": "star-filled",
	"description": "Блок с цифрами доверия.",
	"supports": {
		"html": false
	},
	"attributes": {
		"yearsCount": { "type": "string", "default": "17" },
		"yearsLabel": { "type": "string", "default": "лет" },
		"yearsDesc": { "type": "string", "default": "обслуживаем автомобили" },

		"carsCount": { "type": "string", "default": "12400" },
		"carsHasPlus": { "type": "boolean", "default": true },
		"carsDesc": {
			"type": "string",
			"default": "авто в год проходит через нас"
		},

		"adaptersCount": { "type": "string", "default": "100" },
		"adaptersHasPlus": { "type": "boolean", "default": true },
		"adaptersDesc": {
			"type": "string",
			"default": "адаптеров аппаратной замены"
		},

		"ratingValue": { "type": "string", "default": "5.0" },
		"ratingDesc": { "type": "string", "default": "рейтинг · 557 отзывов" }
	},
	"example": {
		"attributes": {
			"yearsCount": "17",
			"yearsLabel": "лет",
			"yearsDesc": "обслуживаем автомобили",
			"carsCount": "12400",
			"carsHasPlus": true,
			"carsDesc": "авто в год проходит через нас",
			"adaptersCount": "100",
			"adaptersHasPlus": true,
			"adaptersDesc": "адаптеров аппаратной замены",
			"ratingValue": "5.0",
			"ratingDesc": "рейтинг · 557 отзывов"
		}
	},
	"textdomain": "services-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
